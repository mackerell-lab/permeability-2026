			],
			"isBackground": false
		},
		{
			"label": "Summarize localized pairs with PowerShell",
			"type": "shell",
			"command": "$df = Import-Csv \"sGFE_analysis\\bbb_biogen_localized_pairs.csv\"; Write-Host \"TOP_TRANSFORMATIONS\"; $df | Group-Object transformation | Sort-Object Count -Descending | Select-Object -First 10 Count, Name | Format-Table -AutoSize; Write-Host \"`nTOP_CONTEXTS\"; $df | Group-Object context_smiles | Sort-Object Count -Descending | Select-Object -First 10 Count, Name | Format-Table -AutoSize; Write-Host \"`nTOP_ABS_DELTAS\"; $df | Select-Object molecule_a_id, molecule_b_id, transformation, delta_property_b_minus_a, @{Name='abs_delta';Expression={[math]::Abs([double]$_.delta_property_b_minus_a)}} | Sort-Object abs_delta -Descending | Select-Object -First 10 | Format-Table -AutoSize",
